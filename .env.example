# ============================================================
#  Hamilton Lawn Mowing — Live Reviews config (TEMPLATE)
#  Copy this file to  .env  and fill real values.
#  .env is git-ignored and NEVER pushed.
#
#  IMPORTANT: this is a STATIC Netlify site with no build step.
#  Nothing here is auto-injected into the HTML. This file is a
#  CHECKLIST of where each value must be pasted by hand.
# ============================================================

# --- GOES IN GOOGLE APPS SCRIPT -> Project Settings -> Script Properties ---
# (server-side, hidden, safe. NEVER put these in any .html file.)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
GOOGLE_PLACE_ID=your-google-place-id-here

# --- GOES IN index.html  (const GOOGLE_SCRIPT_WEBAPP_URL) ---
# This is the deployed Apps Script Web App URL. NOT secret — it is a
# public endpoint that only returns filtered review JSON.
GOOGLE_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
